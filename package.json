{
  "name": "marcelocfilho-dot-com",
  "version": "0.0.1",
  "private": true,
  "description": "My personal portfolio website.",
  "keywords": [
    "solid",
    "typescript"
  ],
  "homepage": "https://marcelocfilho.com",
  "bugs": {
    "url": "https://github.com/idantitydotme/marcelocfilho.com/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Marcelo Caldart Filho",
    "email": "marcelocfilho96@gmail.com",
    "url": "https://marcelocfilho.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/idantitydotme/marcelocfilho.com.git"
  },
  "type": "module",
  "imports": {
    "#*": [
      "./src/*",
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*/index.ts",
      "./src/*/index.tsx"
    ]
  },
  "scripts": {
    "prepare": "vp config",
    "generate-types": "cf workers types",
    "dev": "vp dev",
    "build": "vp build",
    "preview": "vp preview",
    "deploy": "cf deploy",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "cf d1 migrations apply marcelocfilho-dot-com --dir ./drizzle --local",
    "db:migrate:remote": "cf d1 migrations apply marcelocfilho-dot-com --dir ./drizzle",
    "check": "pnpm audit && cf workers types && vp check --fix"
  },
  "dependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.v.8",
    "@rimelight/auth": "0.0.33",
    "@rimelight/cms": "0.0.44",
    "@rimelight/i18n": "0.1.19",
    "@rimelight/security": "0.0.50",
    "@rimelight/seo": "0.0.38",
    "@rimelight/ui": "0.0.89",
    "@solidjs/router": "2.0.0-next.43",
    "@solidjs/vite-plugin": "3.0.0-next.52",
    "@solidjs/web": "2.0.0-rc.20",
    "drizzle-orm": "1.0.0-rc.5",
    "hono": "5.0.0-rc.1",
    "solid-js": "2.0.0-rc.20",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@iconify-json/logos": "1.2.18",
    "@iconify-json/lucide": "1.2.149",
    "@rimelight/config": "0.0.44",
    "cf": "1.0.0-beta.26",
    "drizzle-kit": "1.0.0-rc.5",
    "filesystem-routing": "0.4.2",
    "typescript": "7.1.0-beta",
    "unocss": "66.12.0",
    "vite-plus": "1.4.0"
  },
  "packageManager": "pnpm@12.16.1"
}
