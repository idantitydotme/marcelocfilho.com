{
  "$schema": "./node_modules/@lunariajs/core/config.schema.json",
  "repository": {
    "name": "idantitydotme/marcelocfilho.com"
  },
  "files": [
    {
      "location": "src/content/docs/**/*.{md,mdx}",
      "pattern": "src/content/docs/@lang/@path",
      "type": "universal"
    }
  ],
  "defaultLocale": {
    "label": "English",
    "lang": "en"
  },
  "locales": [
    {
      "label": "Português",
      "lang": "pt"
    },
    {
      "label": "Español",
      "lang": "es"
    }
  ],
  "dashboard": {
    "title": "Marcelo Filho Localization Status"
  }
}
