---
import AppLayout from '#layouts/AppLayout.astro';
import RLAContainer from '@rimelight/ui/components/container/RLAContainer.astro';
import RLAPageSection from '@rimelight/ui/components/page-section/RLAPageSection.astro';
import RLAGrid from '@rimelight/ui/components/grid/RLAGrid.astro';
import RLACard from '@rimelight/ui/components/card/RLACard.astro';
import RLAButton from '@rimelight/ui/components/button/RLAButton.astro';
import { useI18n, getRelativeLocaleUrl } from "@rimelight/i18n";

const messages = useI18n("page_services");

const servicesList = [
  {
    icon: "i-lucide-volume-2",
    title: messages.soundDesignTitle,
    description: messages.soundDesignDesc
  },
  {
    icon: "i-lucide-footprints",
    title: messages.foleyArtTitle,
    description: messages.foleyArtDesc
  },
  {
    icon: "i-lucide-music",
    title: messages.musicCompositionTitle,
    description: messages.musicCompositionDesc
  },
  {
    icon: "i-lucide-sliders",
    title: messages.mixingMasteringTitle,
    description: messages.mixingMasteringDesc
  }
];
---

<AppLayout title={messages.title} description={messages.description}>
  <RLAContainer class="py-12 sm:py-16 max-w-5xl">
    <header class="mb-12 border-b border-neutral-800 pb-8 text-center max-w-3xl mx-auto">
      <h1 class="text-4xl sm:text-5xl font-extrabold text-white tracking-tight mb-4">{messages.heading}</h1>
      <p class="text-lg sm:text-xl text-neutral-400 leading-relaxed">{messages.subheading}</p>
    </header>

    <section class="mb-16">
      <div class="mb-8">
        <h2 class="text-2xl sm:text-3xl font-bold text-white mb-2">{messages.capabilitiesTitle}</h2>
        <p class="text-neutral-400">{messages.capabilitiesDesc}</p>
      </div>

      <RLAGrid cols={2} class="gap-6">
        {servicesList.map((service) => (
          <div class="rounded-2xl border border-neutral-800 bg-neutral-900/60 p-8 hover:border-primary-500/50 transition-colors flex flex-col justify-between">
            <div>
              <div class="inline-flex items-center justify-center p-3 rounded-xl bg-primary-500/10 text-primary-400 mb-6 text-2xl">
                <span class={service.icon}></span>
              </div>
              <h3 class="text-2xl font-bold text-white mb-3">{service.title}</h3>
              <p class="text-neutral-300 leading-relaxed">{service.description}</p>
            </div>
          </div>
        ))}
      </RLAGrid>
    </section>

    <section class="rounded-3xl border border-neutral-800 bg-gradient-to-br from-neutral-900 to-neutral-950 p-8 sm:p-12 text-center">
      <h2 class="text-3xl font-extrabold text-white mb-4">{messages.ctaTitle}</h2>
      <p class="text-lg text-neutral-400 max-w-2xl mx-auto mb-8 leading-relaxed">{messages.ctaDesc}</p>
      <div class="flex flex-wrap justify-center gap-4">
        <RLAButton
          label={messages.ctaContact || "Get in Touch"}
          href={getRelativeLocaleUrl('/contact')}
          color="primary"
          variant="solid"
          size="lg"
        />
        <RLAButton
          label={messages.ctaProjects || "View Projects"}
          href={getRelativeLocaleUrl('/projects')}
          color="neutral"
          variant="outline"
          size="lg"
          trailingIcon="i-lucide-arrow-right"
        />
      </div>
    </section>
  </RLAContainer>
</AppLayout>
