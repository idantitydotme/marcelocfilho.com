---
import AppLayout from '#layouts/AppLayout.astro';
import { t, getRelativeLocaleUrl, getLocale } from "@rimelight/i18n";

interface Props {
    error: unknown;
}

const { error } = Astro.props;

const activeLocale = getLocale();

---

<AppLayout title={t("errors.serverError")} description={t("errors.serverError")}>
  <div class="error-container">
    <p class="error-code">500</p>
    <h1 class="error-title">{t("errors.serverError")}</h1>
    <p class="error-desc">{error instanceof Error ? error.message : t("errors.unknownError")}</p>
    <a href={getRelativeLocaleUrl(activeLocale, '/')} class="error-link">{t("errors.goHome")}</a>
  </div>
</AppLayout>
