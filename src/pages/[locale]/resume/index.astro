---
import AppLayout from "#layouts/AppLayout.astro";
import RLAContainer from "@rimelight/ui/components/container/RLAContainer.astro";
import RLAButton from "@rimelight/ui/components/button/RLAButton.astro";
import RLAGrid from "@rimelight/ui/components/grid/RLAGrid.astro";
import { useI18n, getRelativeLocaleUrl } from "@rimelight/i18n";

const messages = useI18n("page_resume");

const experiences = [
  {
    role: messages.exp1Role,
    company: messages.exp1Company,
    period: messages.exp1Period,
    bullets: [messages.exp1Bullet1, messages.exp1Bullet2, messages.exp1Bullet3].filter(Boolean)
  },
  {
    role: messages.exp2Role,
    company: messages.exp2Company,
    period: messages.exp2Period,
    bullets: [messages.exp2Bullet1, messages.exp2Bullet2].filter(Boolean)
  },
  {
    role: messages.exp3Role,
    company: messages.exp3Company,
    period: messages.exp3Period,
    bullets: [messages.exp3Bullet1, messages.exp3Bullet2].filter(Boolean)
  }
];

const tools = [
  { name: "Reaper", category: messages.audioProduction, icon: "i-lucide-audio-waveform" },
  { name: "Pro Tools", category: messages.audioProduction, icon: "i-lucide-disc" },
  { name: "DaVinci Resolve", category: messages.videoEditing, icon: "i-lucide-video" }
];
---

<AppLayout title={messages.title} description={messages.description}>
  <RLAContainer class="py-12 sm:py-16 max-w-4xl">
    <!-- Header -->
    <header class="mb-12 border-b border-neutral-800 pb-8 flex flex-col md:flex-row md:items-center justify-between gap-6">
      <div>
        <h1 class="text-4xl sm:text-5xl font-extrabold text-white tracking-tight mb-2">Marcelo Caldart Filho</h1>
        <p class="text-xl text-primary-400 font-medium mb-3">Sound Designer & Musician</p>
        <div class="flex flex-wrap items-center gap-4 text-sm text-neutral-400">
          <span class="flex items-center gap-1.5"><span class="i-lucide-map-pin text-primary-400"></span> {messages.location}</span>
          <span class="flex items-center gap-1.5"><span class="i-lucide-check-circle text-green-400"></span> {messages.availability}</span>
        </div>
      </div>

      <div class="flex flex-wrap gap-3 items-center">
        <RLAButton
          label={messages.downloadCV || "Download CV"}
          href="https://pub-d59ba6f09fc247e5b5215dbca8bb5841.r2.dev/Resume/Resume_Marcelo_C_Filho.pdf"
          target="_blank"
          rel="noopener noreferrer"
          color="primary"
          variant="solid"
          size="lg"
          leadingIcon="i-lucide-download"
        />
      </div>
    </header>

    <div class="space-y-12">
      <!-- Profile -->
      <section>
        <h2 class="text-2xl font-bold text-white mb-4">{messages.aboutSectionTitle}</h2>
        <p class="text-neutral-300 text-lg leading-relaxed">{messages.aboutText}</p>
      </section>

      <!-- Experience -->
      <section class="border-t border-neutral-800 pt-8">
        <h2 class="text-2xl sm:text-3xl font-bold text-white mb-8">{messages.experienceTitle}</h2>
        <div class="space-y-8">
          {experiences.map((exp) => (
            <div class="rounded-2xl border border-neutral-800 bg-neutral-900/50 p-6 sm:p-8">
              <div class="flex flex-col sm:flex-row sm:items-center justify-between mb-4 gap-1">
                <h3 class="text-xl font-bold text-white">{exp.role}</h3>
                <span class="text-xs sm:text-sm font-semibold text-primary-400 px-3 py-1 rounded-full bg-primary-500/10 self-start sm:self-auto">{exp.period}</span>
              </div>
              <p class="text-sm font-medium text-neutral-400 mb-4">{exp.company}</p>
              <ul class="space-y-2 text-neutral-300 list-disc list-inside">
                {exp.bullets.map((bullet) => (
                  <li class="leading-relaxed">{bullet}</li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </section>

      <!-- Education & Certifications -->
      <section class="border-t border-neutral-800 pt-8 grid grid-cols-1 md:grid-cols-2 gap-8">
        <div>
          <h2 class="text-2xl font-bold text-white mb-6">{messages.educationTitle}</h2>
          <div class="rounded-2xl border border-neutral-800 bg-neutral-900/50 p-6">
            <h3 class="text-lg font-bold text-white mb-1">{messages.edu1Degree}</h3>
            <p class="text-primary-400 font-medium text-sm mb-2">{messages.edu1School}</p>
            <span class="text-xs text-neutral-400">{messages.edu1Period}</span>
          </div>
        </div>

        <div>
          <h2 class="text-2xl font-bold text-white mb-6">{messages.certificationsTitle}</h2>
          <div class="space-y-4">
            <div class="rounded-2xl border border-neutral-800 bg-neutral-900/50 p-6">
              <h3 class="text-base font-bold text-white">{messages.cert1Name}</h3>
              <p class="text-xs text-neutral-400 mt-1">{messages.cert1Issuer}</p>
            </div>
            <div class="rounded-2xl border border-neutral-800 bg-neutral-900/50 p-6">
              <h3 class="text-base font-bold text-white">{messages.cert2Name}</h3>
              <p class="text-xs text-neutral-400 mt-1">{messages.cert2Issuer}</p>
            </div>
          </div>
        </div>
      </section>

      <!-- Technologies & Tools -->
      <section class="border-t border-neutral-800 pt-8">
        <h2 class="text-2xl font-bold text-white mb-6">{messages.technologiesTitle}</h2>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          {tools.map((tool) => (
            <div class="flex items-center gap-3 p-4 rounded-xl border border-neutral-800 bg-neutral-900/50">
              <span class={`${tool.icon} text-2xl text-primary-400`}></span>
              <div>
                <div class="font-bold text-white">{tool.name}</div>
                <div class="text-xs text-neutral-400">{tool.category}</div>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- Languages -->
      <section class="border-t border-neutral-800 pt-8 pb-4">
        <h2 class="text-2xl font-bold text-white mb-6">{messages.languagesTitle}</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="p-4 rounded-xl border border-neutral-800 bg-neutral-900/50 flex justify-between items-center">
            <span class="font-bold text-white">{messages.langPt}</span>
            <span class="text-sm text-primary-400 font-medium">{messages.langPtLevel}</span>
          </div>
          <div class="p-4 rounded-xl border border-neutral-800 bg-neutral-900/50 flex justify-between items-center">
            <span class="font-bold text-white">{messages.langEn}</span>
            <span class="text-sm text-primary-400 font-medium">{messages.langEnLevel}</span>
          </div>
        </div>
      </section>
    </div>
  </RLAContainer>
</AppLayout>
