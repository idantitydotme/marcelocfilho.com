---
import AppLayout from '#layouts/AppLayout.astro';
import { t, getRelativeLocaleUrl, getLocale } from "@rimelight/i18n";

const activeLocale = getLocale();

---

<AppLayout title={t("errors.notFound")} description={t("errors.notFoundDesc")}>
  <div class="error-container">
    <p class="error-code">404</p>
    <h1 class="error-title">{t("errors.notFound")}</h1>
    <p class="error-desc">{t("errors.notFoundDesc")}</p>
    <a href={getRelativeLocaleUrl(activeLocale, '/')} class="error-link">{t("errors.goHome")}</a>
  </div>
</AppLayout>
