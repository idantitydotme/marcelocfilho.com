---
import AppLayout from "@/layouts/AppLayout.astro";
import { siteConfig } from "@/config/site.config";
import { useI18n, getLocale, getRelativeLocaleUrl } from "@rimelight/i18n";
import RLAPageSection from "@rimelight/ui/components/page-section/RLAPageSection.astro";
import RLALogo from "@rimelight/ui/components/logo/RLALogo.astro";
import RLAButton from "@rimelight/ui/components/button/RLAButton.astro";
import RLAGrid from "@rimelight/ui/components/grid/RLAGrid.astro";
import RLAContainer from "@rimelight/ui/components/container/RLAContainer.astro";

const activeLocale = getLocale();
const messages = useI18n("playground");

const heroLinks = [
  {
    label: messages.heroTalk || "Let's Talk",
    href: getRelativeLocaleUrl("/contact"),
    color: "primary",
    variant: "solid"
  },
  {
    label: messages.heroProjects || "View Projects",
    href: getRelativeLocaleUrl("/projects"),
    color: "primary",
    variant: "outline",
    trailingIcon: "i-lucide-arrow-right"
  }
];

const ctaLinks = [
  {
    label: messages.ctaContact || "Get in Touch",
    href: getRelativeLocaleUrl("/contact"),
    color: "primary",
    variant: "solid"
  },
  {
    label: messages.ctaResume || "Download CV",
    href: "https://pub-d59ba6f09fc247e5b5215dbca8bb5841.r2.dev/Resume/Resume_Marcelo_C_Filho.pdf",
    target: "_blank",
    color: "neutral",
    variant: "outline",
    trailingIcon: "i-lucide-download"
  }
];

const faqItems = [
  { q: messages.faq1_q, a: messages.faq1_a },
  { q: messages.faq2_q, a: messages.faq2_a },
  { q: messages.faq3_q, a: messages.faq3_a },
  { q: messages.faq4_q, a: messages.faq4_a }
];

const servicesPreview = [
  {
    icon: "i-lucide-volume-2",
    title: "Sound Design",
    description: "Immersive soundscapes and custom SFX for games, film, and multimedia."
  },
  {
    icon: "i-lucide-footprints",
    title: "Foley Art",
    description: "Custom organic Foley recording and physical interaction textures."
  },
  {
    icon: "i-lucide-music",
    title: "Music Composition",
    description: "Original soundtracks, adaptive themes, and emotive scores."
  },
  {
    icon: "i-lucide-sliders",
    title: "Mixing & Mastering",
    description: "Industry-standard balance, clarity, and spatial loudness optimization."
  }
];
---

<AppLayout title={siteConfig.name} description={siteConfig.description}>
  <!-- Hero Section -->
  <RLAPageSection
    variant="hero"
    reverse={true}
    title={messages.heroTitle}
    description={`${messages.heroSubtitle} — ${messages.heroDesc}`}
    links={heroLinks}
  >
    <RLALogo class="pointer-events-none h-64 w-auto drop-shadow-2xl" variant="logomark" />
  </RLAPageSection>

  <!-- About Preview Section -->
  <RLAContainer class="py-12 sm:py-16">
    <div class="rounded-3xl border border-neutral-800 bg-neutral-900/40 p-8 sm:p-12">
      <div class="max-w-3xl">
        <h2 class="text-3xl sm:text-4xl font-extrabold text-white mb-4">{messages.aboutTitle}</h2>
        <p class="text-lg text-neutral-300 leading-relaxed mb-8">{messages.aboutDesc}</p>
        <div class="flex flex-wrap gap-4">
          <RLAButton
            label={messages.aboutLearnMore || "Learn More"}
            href={getRelativeLocaleUrl("/about")}
            color="primary"
            variant="solid"
          />
          <RLAButton
            label={messages.aboutResume || "Resume"}
            href={getRelativeLocaleUrl("/resume")}
            color="neutral"
            variant="outline"
          />
        </div>
      </div>
    </div>
  </RLAContainer>

  <!-- Services Capabilities Section -->
  <RLAPageSection
    orientation="vertical"
    title={messages.servicesTitle}
    description={messages.servicesDesc}
  >
    <div slot="body" class="flex flex-col gap-xl">
      <RLAGrid cols={2} class="gap-6">
        {servicesPreview.map((service) => (
          <div class="rounded-2xl border border-neutral-800 bg-neutral-900/50 p-6 hover:border-primary-500/40 transition-colors">
            <div class="inline-flex items-center justify-center p-3 rounded-xl bg-primary-500/10 text-primary-400 mb-4 text-2xl">
              <span class={service.icon}></span>
            </div>
            <h3 class="text-xl font-bold text-white mb-2">{service.title}</h3>
            <p class="text-neutral-300 text-sm leading-relaxed">{service.description}</p>
          </div>
        ))}
      </RLAGrid>

      <div class="flex justify-center mt-4">
        <RLAButton
          label={messages.servicesViewAll || "View All Services"}
          href={getRelativeLocaleUrl("/services")}
          color="primary"
          variant="link"
          trailingIcon="i-lucide-arrow-right"
        />
      </div>
    </div>
  </RLAPageSection>

  <!-- FAQ Section -->
  <RLAContainer class="py-12 sm:py-16 max-w-4xl">
    <div class="text-center mb-12">
      <h2 class="text-3xl sm:text-4xl font-extrabold text-white mb-3">{messages.faqTitle}</h2>
      <p class="text-lg text-neutral-400 max-w-2xl mx-auto">{messages.faqDesc}</p>
    </div>

    <div class="space-y-4">
      {faqItems.map((item) => (
        <div class="rounded-2xl border border-neutral-800 bg-neutral-900/50 p-6">
          <h3 class="text-lg font-bold text-white mb-2 flex items-center gap-2">
            <span class="text-primary-400">Q.</span> {item.q}
          </h3>
          <p class="text-neutral-300 text-base leading-relaxed pl-6">{item.a}</p>
        </div>
      ))}
    </div>
  </RLAContainer>

  <!-- CTA Section -->
  <RLAPageSection
    variant="cta"
    ctaVariant="solid"
    title={messages.ctaTitle}
    description={messages.ctaDesc}
    links={ctaLinks}
  />
</AppLayout>
