---
import RLAHeader from "@rimelight/ui/components/astro/RLAHeader.astro";
import RLAButton from "@rimelight/ui/components/astro/RLAButton.astro";
import type { NavigationMenuItem } from "@rimelight/ui/types"
import { NavigationMenu } from "@rimelight/ui/nuxt"
import { getRelativeLocaleUrl } from "astro:i18n";
import { useI18n, currentLocale as localeStore } from "astro-nanostores-i18n:runtime";

const activeLocale = Astro.currentLocale ?? "en";
localeStore.set(activeLocale);

const pathname = Astro.url.pathname.replace(/\/+$/, '') || '/';

const messages = useI18n("app_header", {
	"links_projects_label": "Projects",
	"links_blog_label": "Blog",
	"links_about_label": "About"
});

const items: NavigationMenuItem[] = [
  {
    label: messages["links_projects_label"],
    to: getRelativeLocaleUrl(activeLocale, '/'),
    active: pathname === getRelativeLocaleUrl(activeLocale, '/').replace(/\/+$/, '')
  },
  {
    label: messages["links_blog_label"],
    to: getRelativeLocaleUrl(activeLocale, '/blog'),
    active: pathname.startsWith(getRelativeLocaleUrl(activeLocale, '/blog').replace(/\/+$/, ''))
  },
  {
    label: messages["links_about_label"],
    to: getRelativeLocaleUrl(activeLocale, '/docs'),
    active: pathname.startsWith(getRelativeLocaleUrl(activeLocale, '/docs').replace(/\/+$/, ''))
  }
];
---

<RLAHeader contain={true} fixed={true} stackIndex={0} class="bg-white/90 shadow-[0_2px_8px_rgba(0,0,0,0.05)]">
	<div slot="left" class="flex flex-row items-center gap-md">
		<NavigationMenu
			client:load
			items={items}
			variant="link"
			ui={{
				link: [
					'text-white transition-colors duration-200',
					'hover:text-primary-400',
					'data-[state=open]:text-primary-400',
					'aria-[current]:text-primary-400'
				]
			}}
		/>
	</div>
	<div slot="center" class="items-center">
		<span>Marcelo Caldart Filho</span>
	</div>
	<div slot="right" class="flex gap-sm items-right">
		<RLAButton
			size="xl"
			color="neutral"
			variant="ghost"
			leadingIcon="i-logos-soundcloud-icon?mask text-white hover:text-primary-500"
			size="xl"
			href="https://www.soundcloud.com/marcelo-filho-32565359"
		/>
		<RLAButton
			size="xl"
			color="neutral"
			variant="ghost"
			leadingIcon="i-logos-linkedin-icon?mask text-white hover:text-primary-500"
			href="https://www.linkedin.com/marcelocfilho"
		/>
	</div>
</RLAHeader>
