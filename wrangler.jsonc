{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "marcelocfilho-dot-com",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-05-01",
  "compatibility_flags": ["global_fetch_strictly_public", "nodejs_compat"],
  "cache": {
    "enabled": true
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true
    }
  },
  //  "routes": [
  //    {
  //      "pattern": "marcelocfilho.com",
  //      "custom_domain": true
  //    },
  //    {
  //      "pattern": "www.marcelocfilho.com",
  //      "custom_domain": true
  //    }
  //  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "r2_buckets": [
    {
      "binding": "BLOB",
      "bucket_name": "marcelocfilho-dot-com"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "marcelocfilho-dot-com-translations",
      "id": "c06d6e52f8d840ac976783a7a6f7ef4a"
    }
  ],
  "ratelimits": [
    {
      "namespace_id": "1001",
      "name": "MY_RATE_LIMITER",
      "simple": {
        "limit": 100,
        "period": 60
      }
    }
  ],
  "triggers": {
    "crons": ["* * * * *"]
  },
  "vars": {
    "CONSTRUCTION_MODE": "true",
    "CONSTRUCTION_AUTH": "true",
    "CONSTRUCTION_GUEST_EMAIL": "guest@marcelocfilho.com"
  }
}
